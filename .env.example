# OpenAI API Key (optional - only needed if using OpenAI instead of local LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# LM Studio Configuration (default local setup)
LM_STUDIO_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL=gemma-3-27b-it
LM_STUDIO_EMBEDDING=text-embedding-nomic-embed-text-v1.5-embedding

# Ollama Configuration (alternative to LM Studio)
# Uncomment these lines and comment out LM Studio config above to use Ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3
# OLLAMA_EMBEDDING=nomic-embed-text

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3111
